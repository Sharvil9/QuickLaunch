{
  "manifest_version": 3,
  "name": "QuickLaunch",
  "version": "1.1.0",
  "description": "Fast shortcuts to AI tools, work apps, calendars and time tools.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "action": {
    "default_popup": "dist/index.html"
  },
  "side_panel": {
    "default_path": "dist/timer.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "quicklaunch@example.com",
      "strict_min_version": "109.0"
    }
  }
}
